<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Updater 与主程序共用系统 .NET 8 Desktop Runtime：
		     主程序本身就是 framework-dependent，目标机必然已装 runtime，
		     故 Updater 无需自带 runtime（self-contained 会让单文件膨胀到 ~64MB）。
		     实测 framework-dependent + single-file ≈ 0.16MB，仍是单个 exe，部署方式不变。 -->
		<SelfContained>false</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishTrimmed>false</PublishTrimmed>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<!-- 改名以减少误报 -->
		<AssemblyName>SafeMonitor.Updater</AssemblyName>
		<!-- 程序集元数据 (增加可信度) -->
		<Company>SafeMonitor</Company>
		<Product>SafeMonitor Auto Updater</Product>
		<Description>Automatic update component for SafeMonitor system monitoring tool.</Description>
		<Copyright>Copyright © 2025-2026 SafeMonitor Team</Copyright>
		<FileVersion>1.2.5.0</FileVersion>
		<AssemblyVersion>1.2.5.0</AssemblyVersion>

		<!-- 禁用顶级语句 -->
		<UseMaui>false</UseMaui>

		<!-- 指定 Main 入口 -->
		<StartupObject>SafeMonitor.Updater.Program</StartupObject>
	</PropertyGroup>
</Project>
